#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
NODE_BIN="${QUIETLSP_NODE:-$(command -v node || true)}"
[ -n "$NODE_BIN" ] || { echo "install-quietlsp: FATAL no node found" >&2; exit 1; }
exec "$NODE_BIN" "$SELF_DIR/install-quietlsp.mjs" "$@"
