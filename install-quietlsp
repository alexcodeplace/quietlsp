#!/usr/bin/env bash
# install-quietlsp — install PATH-shadowing wrappers for Claude Code language servers.
#
# Claude Code currently resolves typescript-language-server and rust-analyzer by
# command name. QuietLSP shadows those names in QUIETLSP_SHIM_DIR (default
# $HOME/.claude/bin), then launches the real binary found later on PATH.
#
# Never edit Claude Code plugin-cache files: updates may replace them and the
# cache is not a reliable interception point. If another tool manages the default
# shim directory, set QUIETLSP_SHIM_DIR to an unmanaged directory that appears
# before the real language-server binaries on PATH.
#
# The installer is idempotent and refuses to overwrite foreign files.
set -uo pipefail

MARKER_FAMILY="quietlsp-guard"
MARKER="$MARKER_FAMILY v2"
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"
QUIETLSP_BIN="$SELF_DIR/quietlsp"
SHIM_DIR="${QUIETLSP_SHIM_DIR:-$HOME/.claude/bin}"
NODE_BIN="${QUIETLSP_NODE:-}"

usage() {
  cat >&2 <<'USAGE'
usage: install-quietlsp [--uninstall] [--status]

Wraps the TypeScript and rust-analyzer language servers so Claude Code's LSP
feature only receives diagnostics for files inside a session's own cwd, via
a PATH-shadowing shim in ${QUIETLSP_SHIM_DIR:-$HOME/.claude/bin}.

  --status     report wrapped/unwrapped/drifted per target, exit 1 if any
               target is not `wrapped`
  --uninstall  remove the shims this installer created (the real installs at
               /usr/local/bin and ~/.cargo/bin were never touched)
USAGE
  exit "${1:-2}"
}

RUN_MODE=install
while [ $# -gt 0 ]; do
  case "$1" in
    --uninstall) RUN_MODE=uninstall; shift ;;
    --status)    RUN_MODE=status; shift ;;
    -h|--help)   usage 0 ;;
    *)           echo "install-quietlsp: unknown arg: $1" >&2; usage ;;
  esac
done

if [ -z "$NODE_BIN" ]; then
  for cand in /usr/bin/node /usr/local/bin/node; do
    [ -x "$cand" ] && ! head -c 4 -- "$cand" 2>/dev/null | grep -q '#!/u' && { NODE_BIN="$cand"; break; }
  done
fi
[ -n "$NODE_BIN" ] || NODE_BIN="$(command -v node || true)"
if [ -z "$NODE_BIN" ]; then
  echo "install-quietlsp: FATAL no node found — quietlsp requires node" >&2
  exit 1
fi
[ -x "$QUIETLSP_BIN" ] || { echo "install-quietlsp: FATAL missing wrapper at $QUIETLSP_BIN" >&2; exit 1; }
mkdir -p "$SHIM_DIR" || { echo "install-quietlsp: FATAL cannot create $SHIM_DIR" >&2; exit 1; }

TARGETS=(typescript-language-server rust-analyzer)

# Resolves the real (non-quietlsp) absolute binary for a command name by
# walking PATH and skipping our own shim dir (else a rerun would shadow
# itself and resolve to its own shim in an infinite loop).
resolve_real() {
  local cmd=$1 entry cand
  IFS=':' read -ra parts <<<"$PATH"
  for entry in "${parts[@]}"; do
    [ "$entry" = "$SHIM_DIR" ] && continue
    cand="$entry/$cmd"
    if [ -x "$cand" ] && [ ! -d "$cand" ]; then
      readlink -f -- "$cand" 2>/dev/null || echo "$cand"
      return 0
    fi
  done
  return 1
}

shim_body() {
  local cmd=$1 real=$2
  cat <<SHIM
#!/usr/bin/env bash
# $MARKER — DO NOT EDIT. Reinstall with install-quietlsp (from the quietlsp repo).
exec "$NODE_BIN" "$QUIETLSP_BIN" "$real" "\$@"
SHIM
}

is_shim() { grep -qF "$MARKER_FAMILY" <(head -c 200 -- "$1" 2>/dev/null); }
shim_is_current() { [ "$(cat -- "$1" 2>/dev/null)" = "$(shim_body "$2" "$3")" ]; }

wrapped=0; refreshed=0; current=0; unwrapped=0; stale=0; restored=0; skipped=0

for cmd in "${TARGETS[@]}"; do
  dest="$SHIM_DIR/$cmd"
  real="$(resolve_real "$cmd" || true)"
  if [ -z "$real" ]; then
    echo "install-quietlsp: WARN no real '$cmd' found on PATH outside $SHIM_DIR — skipping" >&2
    skipped=$((skipped+1))
    continue
  fi

  case "$RUN_MODE" in
    install)
      if [ -e "$dest" ] && ! is_shim "$dest"; then
        echo "install-quietlsp: FATAL $dest exists and is not a quietlsp shim — refusing to overwrite" >&2
        exit 1
      fi
      if [ -e "$dest" ] && shim_is_current "$dest" "$cmd" "$real"; then
        current=$((current+1)); continue
      fi
      tmp="$dest.quietlsp.$$"
      shim_body "$cmd" "$real" >"$tmp" || { rm -f -- "$tmp"; echo "install-quietlsp: FATAL cannot write $dest" >&2; exit 1; }
      chmod 755 "$tmp"
      if [ -e "$dest" ]; then refreshed=$((refreshed+1)); else wrapped=$((wrapped+1)); fi
      mv -f -- "$tmp" "$dest" || { rm -f -- "$tmp"; echo "install-quietlsp: FATAL cannot install $dest" >&2; exit 1; }
      ;;
    status)
      if [ ! -e "$dest" ]; then
        unwrapped=$((unwrapped+1)); echo "UNWRAPPED $dest"
      elif ! is_shim "$dest"; then
        unwrapped=$((unwrapped+1)); echo "UNWRAPPED $dest (foreign file, not a quietlsp shim)"
      elif shim_is_current "$dest" "$cmd" "$real"; then
        wrapped=$((wrapped+1))
      else
        stale=$((stale+1)); echo "DRIFTED $dest"
      fi
      ;;
    uninstall)
      if [ -e "$dest" ] && is_shim "$dest"; then
        rm -f -- "$dest" && restored=$((restored+1))
      fi
      ;;
  esac
done

case "$RUN_MODE" in
  install)   echo "install-quietlsp: wrapped=$wrapped refreshed=$refreshed current=$current skipped=$skipped ($SHIM_DIR)" ;;
  uninstall) echo "install-quietlsp: restored=$restored ($SHIM_DIR)" ;;
  status)
    echo "install-quietlsp: wrapped=$wrapped stale=$stale unwrapped=$unwrapped skipped=$skipped ($SHIM_DIR)"
    [ "$unwrapped" -eq 0 ] && [ "$stale" -eq 0 ] || exit 1 ;;
esac
